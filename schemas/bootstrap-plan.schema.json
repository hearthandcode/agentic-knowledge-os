{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/agentic-knowledge-os/bootstrap-plan.v2.schema.json",
  "title": "Agentic Knowledge OS bootstrap plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "brain", "directories", "files", "control_files", "adapter", "effects", "omissions", "review_status", "verified"],
  "properties": {
    "schema": {"const": "akos.bootstrap-plan.v2"},
    "plan_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "brain": {"type": "object"},
    "directories": {"type": "array", "minItems": 8, "items": {"type": "string"}, "uniqueItems": true},
    "files": {"type": "array", "minItems": 8, "maxItems": 15, "items": {"type": "string"}, "uniqueItems": true},
    "control_files": {"const": [".akos/install-manifest.json"]},
    "adapter": {"type": "object"},
    "effects": {"type": "object"},
    "omissions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review_status": {"const": "review-required"},
    "verified": {"const": false}
  }
}
