{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/agentic-knowledge-os/governance-benchmark-suite.v1.schema.json",
  "title": "Agentic Knowledge OS governance benchmark suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "version", "axes", "hard_gate_events", "thresholds", "cases", "claim_boundary", "review_status", "verified"],
  "properties": {
    "schema": {"const": "akos.governance-benchmark-suite.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "axes": {"const": ["policy_adherence", "profile_routing", "provenance", "effect_boundaries", "return_quality"]},
    "hard_gate_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_conformance_score", "minimum_axis_scores"],
      "properties": {
        "minimum_conformance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_axis_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_adherence", "profile_routing", "provenance", "effect_boundaries", "return_quality"],
          "properties": {
            "policy_adherence": {"type": "number", "minimum": 0, "maximum": 1},
            "profile_routing": {"type": "number", "minimum": 0, "maximum": 1},
            "provenance": {"type": "number", "minimum": 0, "maximum": 1},
            "effect_boundaries": {"type": "number", "minimum": 0, "maximum": 1},
            "return_quality": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "cases": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/case"}},
    "claim_boundary": {"const": "policy-conformance-only-not-effectiveness"},
    "review_status": {"const": "review-required"},
    "verified": {"const": false}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "prompt", "expected_profile", "governance_refs", "weight", "checks"],
      "properties": {
        "id": {"type": "string", "pattern": "^akos\\.eval\\."},
        "title": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "expected_profile": {"type": "string", "pattern": "^akos\\.core8\\."},
        "governance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AKOS-RFC-0001\\.[0-9]+$"}},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_adherence", "profile_routing", "provenance", "effect_boundaries", "return_quality"],
          "properties": {
            "policy_adherence": {
              "type": "object", "additionalProperties": false, "required": ["required_events"],
              "properties": {"required_events": {"$ref": "#/$defs/strings"}}
            },
            "profile_routing": {
              "type": "object", "additionalProperties": false, "required": ["selected_profile"],
              "properties": {"selected_profile": {"type": "string", "pattern": "^akos\\.core8\\."}}
            },
            "provenance": {
              "type": "object", "additionalProperties": false, "required": ["required_epistemic_classes"],
              "properties": {"required_epistemic_classes": {"$ref": "#/$defs/strings"}}
            },
            "effect_boundaries": {
              "type": "object", "additionalProperties": false, "required": ["forbidden_events", "unauthorized_effects"],
              "properties": {"forbidden_events": {"$ref": "#/$defs/strings"}, "unauthorized_effects": {"const": "none"}}
            },
            "return_quality": {
              "type": "object", "additionalProperties": false, "required": ["allowed_statuses", "minimum_evidence_refs"],
              "properties": {"allowed_statuses": {"$ref": "#/$defs/strings"}, "minimum_evidence_refs": {"type": "integer", "minimum": 1}}
            }
          }
        }
      }
    }
  }
}
