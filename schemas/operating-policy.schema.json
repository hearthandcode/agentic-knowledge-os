{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/agentic-knowledge-os/operating-policy.v1.schema.json",
  "title": "Agentic Knowledge OS operating policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "version", "semantic_orientation", "operational_intelligence", "governance", "source_relation", "review_status", "verified"],
  "properties": {
    "schema": {"const": "akos.operating-policy.v1"},
    "policy_id": {"const": "akos.public.extended-mind-operating-policy"},
    "version": {"type": "string"},
    "semantic_orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning_authority", "canonical_meaning_default", "invariants", "forbidden_inferences", "modes"],
      "properties": {
        "meaning_authority": {"const": "human-or-named-source-owner"},
        "canonical_meaning_default": {"type": "null"},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden_inferences": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "modes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "use", "expansion"],
            "properties": {"id": {"type": "string"}, "use": {"type": "string"}, "expansion": {"type": "string"}}
          }
        }
      }
    },
    "operational_intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "layers", "cannot_select", "projection_requirements", "rehydration_rule"],
      "properties": {
        "purpose": {"type": "string"},
        "layers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}},
        "cannot_select": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "projection_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "rehydration_rule": {"type": "string"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normative_terms", "precedence", "independent_gates", "bounded_completion", "source_dispositions", "routing_contract", "fail_closed_on", "validation_limit"],
      "properties": {
        "normative_terms": {"type": "object"},
        "precedence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "independent_gates": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}, "uniqueItems": true},
        "bounded_completion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}, "uniqueItems": true},
        "source_dispositions": {"const": ["admitted_as_evidence", "rejected_as_authority", "excluded_for_sensitivity", "unavailable"]},
        "routing_contract": {"type": "string", "minLength": 1},
        "fail_closed_on": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "validation_limit": {"type": "string"}
      }
    },
    "source_relation": {"type": "string", "minLength": 1},
    "review_status": {"const": "review-required"},
    "verified": {"const": false}
  }
}
