{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/agentic-knowledge-os/governance-scorer-audit.v1.schema.json",
  "title": "Agentic Knowledge OS governance scorer mutation audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "probe_count", "detected_count", "detection_score", "probes", "claim_boundary", "review_status", "verified"],
  "properties": {
    "schema": {"const": "akos.governance-scorer-audit.v1"},
    "status": {"enum": ["passed", "failed"]},
    "probe_count": {"type": "integer", "minimum": 1},
    "detected_count": {"type": "integer", "minimum": 0},
    "detection_score": {"type": "number", "minimum": 0, "maximum": 1},
    "probes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "expected", "observed", "detected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "observed": {"type": "string", "minLength": 1},
          "detected": {"type": "boolean"}
        }
      }
    },
    "claim_boundary": {"const": "scorer-mutation-detection-only-not-system-effectiveness"},
    "review_status": {"const": "review-required"},
    "verified": {"const": false}
  }
}
