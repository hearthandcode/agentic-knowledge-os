{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/agentic-knowledge-os/brain.v1.schema.json",
  "title": "Agentic Knowledge OS brain manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "workspace_root", "host", "profiles", "governance", "review_status", "verified"],
  "properties": {
    "schema": {"const": "akos.brain.v1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "workspace_root": {"type": "string", "minLength": 1},
    "host": {"enum": ["neutral", "hermes", "pi", "exocore"]},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "pattern": "^akos\\.core8\\."}, "uniqueItems": true},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_first", "no_write_back", "human_effect_gates", "provider_neutral"],
      "properties": {
        "local_first": {"const": true},
        "no_write_back": {"const": true},
        "human_effect_gates": {"const": true},
        "provider_neutral": {"const": true}
      }
    },
    "review_status": {"const": "review-required"},
    "verified": {"const": false}
  }
}
