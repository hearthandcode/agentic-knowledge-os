{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/agentic-knowledge-os/behavioral-observations.v1.schema.json",
  "title": "Agentic Knowledge OS matched behavioral observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "plan_digest", "measurement_class", "runner", "host", "model", "records", "review_status", "verified"],
  "properties": {
    "schema": {"const": "akos.behavioral-observations.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "measurement_class": {"enum": ["synthetic", "runner-observed"]},
    "runner": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "model": {"type": ["string", "null"]},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "review_status": {"const": "review-required"},
    "verified": {"const": false}
  },
  "$defs": {
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["governed_task_success_rate", "task_utility", "source_fidelity", "correction_efficiency", "resource_efficiency", "recovery_quality", "agency_preservation", "profile_routing", "contract_adherence", "adversarial_resistance"],
      "properties": {
        "governed_task_success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "task_utility": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source_fidelity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "correction_efficiency": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "resource_efficiency": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recovery_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "agency_preservation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "profile_routing": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "contract_adherence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "adversarial_resistance": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "methods": {
      "type": "object", "additionalProperties": false,
      "required": ["governed_task_success_rate", "task_utility", "source_fidelity", "correction_efficiency", "resource_efficiency", "recovery_quality", "agency_preservation", "profile_routing", "contract_adherence", "adversarial_resistance"],
      "properties": {
        "governed_task_success_rate": {"type": "string", "minLength": 1},
        "task_utility": {"type": "string", "minLength": 1},
        "source_fidelity": {"type": "string", "minLength": 1},
        "correction_efficiency": {"type": "string", "minLength": 1},
        "resource_efficiency": {"type": "string", "minLength": 1},
        "recovery_quality": {"type": "string", "minLength": 1},
        "agency_preservation": {"type": "string", "minLength": 1},
        "profile_routing": {"type": "string", "minLength": 1},
        "contract_adherence": {"type": "string", "minLength": 1},
        "adversarial_resistance": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "split", "condition", "repetition", "metrics", "measurement_methods", "hard_gate_failures", "integrity_failures", "evidence_refs"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["calibration", "held-out"]},
        "condition": {"enum": ["structured-baseline", "agents-md-only", "akos"]},
        "repetition": {"type": "integer", "minimum": 1},
        "metrics": {"$ref": "#/$defs/metrics"},
        "measurement_methods": {"$ref": "#/$defs/methods"},
        "hard_gate_failures": {"type": "array", "uniqueItems": true, "items": {"enum": ["semantic_auto_acceptance", "unauthorized_effect", "private_source_disclosure", "profile_state_borrowed", "silent_write_back"]}},
        "integrity_failures": {"type": "array", "uniqueItems": true, "items": {"enum": ["contract_violation"]}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
