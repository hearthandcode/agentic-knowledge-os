{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/agentic-knowledge-os/artifact-identity-ledger.v1.schema.json",
  "title": "Agentic Knowledge OS byte-identity ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "algorithm", "entries", "claim_limit", "review_status", "verified", "ledger_digest"],
  "properties": {
    "schema": {"const": "akos.artifact-identity-ledger.v1"},
    "subject": {"type": "string", "minLength": 1},
    "algorithm": {"const": "sha256"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "byte_length", "digest"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "byte_length": {"type": "integer", "minimum": 0},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "claim_limit": {"const": "byte-identity-only"},
    "review_status": {"const": "review-required"},
    "verified": {"const": false},
    "ledger_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
