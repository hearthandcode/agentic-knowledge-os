{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AKOS compact artifact request v1",
  "description": "Wire shape. The compiler additionally validates supported schema keywords, pointer resolution, source admission, constraint consistency and budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "artifact_path", "profile_id", "audience", "max_attempts", "content_schema", "sources", "checks"],
  "properties": {
    "schema": {"const": "akos.artifact-request.v1"},
    "task": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "profile_id": {"enum": [null, "akos.core8.coordinator", "akos.core8.context-curator", "akos.core8.evidence-analyst", "akos.core8.knowledge-architect", "akos.core8.knowledge-engineer", "akos.core8.builder", "akos.core8.reviewer", "akos.core8.steward"]},
    "audience": {"enum": ["public", "private"]},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 2},
    "content_schema": {"$ref": "#/$defs/contentSchema"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "contentSchema": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"oneOf": [
          {"enum": ["object", "array", "string", "number", "integer", "boolean", "null"]},
          {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["object", "array", "string", "number", "integer", "boolean", "null"]}}
        ]},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/contentSchema"}},
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "additionalProperties": {"const": false},
        "items": {"$ref": "#/$defs/contentSchema"},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true},
        "const": true,
        "description": {"type": "string"},
        "title": {"type": "string"},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 0},
        "uniqueItems": {"type": "boolean"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "availability", "sensitivity", "authority", "data"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "availability": {"enum": ["available", "unavailable"]},
        "sensitivity": {"enum": ["public", "private"]},
        "authority": {"enum": ["source", "decision", "untrusted", "unknown"]},
        "data": true
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "target", "source_id", "source_pointer", "operation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"type": "string"},
        "source_id": {"type": "string", "minLength": 1},
        "source_pointer": {"type": "string"},
        "operation": {"enum": ["copy", "scale"]},
        "factor": {"type": "number"}
      },
      "if": {"properties": {"operation": {"const": "scale"}}},
      "then": {"required": ["factor"]},
      "else": {"properties": {"factor": false}}
    }
  }
}
