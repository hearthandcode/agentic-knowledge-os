{
  "schema": "akos.type-kernel.v1",
  "kernel_id": "akos.public.type-kernel",
  "version": "0.3.0-alpha.1",
  "closed_world": true,
  "unknown_type_behavior": "hold-dependent-transformation",
  "shared_kernel": ["SourceBinding", "Diagnostic", "ReturnEnvelope"],
  "epistemic_classes": ["source", "evidence", "inference", "hypothesis", "proposal", "claim", "decision", "projection", "receipt", "historical", "unknown"],
  "types": [
    {"id": "SourceBinding", "owner": "shared", "kind": "record", "nullable": false, "cardinality": "one-or-more", "description": "Owner, source locator, revision or digest, audience, sensitivity, and access boundary."},
    {"id": "Diagnostic", "owner": "shared", "kind": "record", "nullable": false, "cardinality": "zero-or-more", "description": "Attributed observation of a conflict, absence, drift, or failed guard."},
    {"id": "ReturnEnvelope", "owner": "shared", "kind": "envelope", "nullable": false, "cardinality": "exactly-one", "description": "Achieved state, evidence, limits, holds, effects, and smallest safe next action."},
    {"id": "HumanInstruction", "owner": "human", "kind": "authority", "nullable": false, "cardinality": "zero-or-more", "description": "Exact current instruction whose effect scope is not generalized."},
    {"id": "HumanDecision", "owner": "human", "kind": "authority", "nullable": false, "cardinality": "zero-or-more", "description": "Explicit disposition by the person who owns the decision."},
    {"id": "AcceptedMeaning", "owner": "human", "kind": "authority", "nullable": false, "cardinality": "zero-or-more", "description": "A literal-to-meaning disposition explicitly accepted by its semantic owner."},
    {"id": "TaskRequest", "owner": "coordinator", "kind": "input", "nullable": false, "cardinality": "exactly-one", "description": "Bounded objective, scope, constraints, effect ceiling, stop, and return condition."},
    {"id": "WorkPlan", "owner": "coordinator", "kind": "output", "nullable": false, "cardinality": "zero-or-one", "description": "Reviewable sequence of guarded work without execution authority."},
    {"id": "DelegationEnvelope", "owner": "coordinator", "kind": "envelope", "nullable": false, "cardinality": "zero-or-more", "description": "Role, inputs, owned paths, no-touch paths, budget, evidence, stop, and return contract."},
    {"id": "ContextBudget", "owner": "context-curator", "kind": "input", "nullable": false, "cardinality": "exactly-one", "description": "Bound on sources, tokens, sensitivity, freshness, and exclusions."},
    {"id": "ContextPack", "owner": "context-curator", "kind": "output", "nullable": false, "cardinality": "zero-or-one", "description": "Ordered source references for one consuming task, never a replacement for the sources."},
    {"id": "OmissionLedger", "owner": "context-curator", "kind": "output", "nullable": false, "cardinality": "exactly-one", "description": "Excluded, unavailable, stale, or truncated context with consequences."},
    {"id": "RefreshRule", "owner": "context-curator", "kind": "output", "nullable": false, "cardinality": "exactly-one", "description": "Conditions requiring direct-source rehydration."},
    {"id": "ReviewCriterion", "owner": "evidence-analyst", "kind": "record", "nullable": false, "cardinality": "one-or-more", "description": "Named predicate, evidence method, and proof limit."},
    {"id": "EvidenceRecord", "owner": "evidence-analyst", "kind": "output", "nullable": false, "cardinality": "zero-or-more", "description": "Method, time, scope, observation, uncertainty, and limitation."},
    {"id": "ClaimLedger", "owner": "evidence-analyst", "kind": "output", "nullable": false, "cardinality": "zero-or-more", "description": "Claim-to-source and counterevidence mapping with epistemic class."},
    {"id": "UncertaintyRecord", "owner": "evidence-analyst", "kind": "output", "nullable": false, "cardinality": "zero-or-more", "description": "Unknown, alternative interpretation, disconfirming evidence, and resolution need."},
    {"id": "ConsumerNeed", "owner": "knowledge-architect", "kind": "input", "nullable": false, "cardinality": "one-or-more", "description": "Present question, decision, navigation, or retrieval need."},
    {"id": "KnowledgeModel", "owner": "knowledge-architect", "kind": "record", "nullable": false, "cardinality": "zero-or-one", "description": "Semantic entities, distinctions, owners, relations, lifecycle, and routes."},
    {"id": "BoundaryMap", "owner": "knowledge-architect", "kind": "output", "nullable": false, "cardinality": "exactly-one", "description": "Semantic, ownership, system, privacy, and lifecycle boundaries."},
    {"id": "MigrationProposal", "owner": "knowledge-architect", "kind": "output", "nullable": false, "cardinality": "zero-or-one", "description": "Candidate source-to-target transition with loss, gates, idempotence, and rollback."},
    {"id": "SourceContract", "owner": "knowledge-engineer", "kind": "input", "nullable": false, "cardinality": "exactly-one", "description": "Direct source shape, semantics, owner, revision, and invariants."},
    {"id": "ConsumerContract", "owner": "knowledge-engineer", "kind": "input", "nullable": false, "cardinality": "exactly-one", "description": "Expected output types, semantics, cardinality, and failure behavior."},
    {"id": "MappingRequirement", "owner": "knowledge-engineer", "kind": "input", "nullable": false, "cardinality": "one-or-more", "description": "Required source-to-consumer correspondence and permitted loss."},
    {"id": "SchemaContract", "owner": "knowledge-engineer", "kind": "output", "nullable": false, "cardinality": "zero-or-more", "description": "Closed syntax and structural validity contract with explicit nullability and defaults."},
    {"id": "Crosswalk", "owner": "knowledge-engineer", "kind": "output", "nullable": false, "cardinality": "zero-or-one", "description": "Attributed mapping among source terms, normalized terms, and projection fields."},
    {"id": "TransformationContract", "owner": "knowledge-engineer", "kind": "output", "nullable": false, "cardinality": "zero-or-one", "description": "Typed partial function with guards, invariants, losses, failures, and fixtures."},
    {"id": "AcceptedScope", "owner": "human", "kind": "authority", "nullable": false, "cardinality": "exactly-one", "description": "Exact human-released implementation scope and effect ceiling."},
    {"id": "DesignContract", "owner": "builder", "kind": "input", "nullable": false, "cardinality": "exactly-one", "description": "Accepted or explicitly released design inputs and checks."},
    {"id": "CandidateArtifact", "owner": "builder", "kind": "output", "nullable": false, "cardinality": "zero-or-more", "description": "Bounded implementation or document that remains a candidate until disposition."},
    {"id": "ReviewFinding", "owner": "reviewer", "kind": "output", "nullable": false, "cardinality": "zero-or-more", "description": "Attributed criterion, observation, evidence, severity, uncertainty, and remedy question."},
    {"id": "DispositionCandidate", "owner": "reviewer", "kind": "output", "nullable": false, "cardinality": "exactly-one", "description": "Reviewer recommendation that cannot accept or release the candidate."},
    {"id": "ReviewQuestion", "owner": "reviewer", "kind": "output", "nullable": false, "cardinality": "zero-or-more", "description": "Bounded unresolved question for the decision owner."},
    {"id": "ArtifactState", "owner": "steward", "kind": "input", "nullable": false, "cardinality": "exactly-one", "description": "Artifact identity, owner, lifecycle, lineage, and current storage state."},
    {"id": "SensitivityLabel", "owner": "steward", "kind": "input", "nullable": false, "cardinality": "exactly-one", "description": "Public, private, restricted, mixed, or unknown handling class."},
    {"id": "LifecycleRule", "owner": "steward", "kind": "input", "nullable": false, "cardinality": "one-or-more", "description": "Retention, supersession, archive, deletion, and recovery rule."},
    {"id": "ContinuityRecord", "owner": "steward", "kind": "output", "nullable": false, "cardinality": "exactly-one", "description": "Lineage, present state, blocked effect, missing evidence, and resume route."},
    {"id": "RecoveryPlan", "owner": "steward", "kind": "output", "nullable": false, "cardinality": "zero-or-one", "description": "Bounded restoration path, prerequisites, risks, and stop condition."},
    {"id": "LifecycleHandoff", "owner": "steward", "kind": "output", "nullable": false, "cardinality": "exactly-one", "description": "Next lifecycle transition, gate owner, preserved evidence, and safe stop."}
  ],
  "relations": [
    {"id": "derived-from", "domain": "record", "range": "SourceBinding", "directional": true, "transitive": false, "evidence_required": true, "cycle_policy": "forbid"},
    {"id": "projects-to", "domain": "record", "range": "record", "directional": true, "transitive": false, "evidence_required": true, "cycle_policy": "forbid"},
    {"id": "supports", "domain": "EvidenceRecord", "range": "ClaimLedger", "directional": true, "transitive": false, "evidence_required": true, "cycle_policy": "forbid"},
    {"id": "contradicts", "domain": "EvidenceRecord", "range": "ClaimLedger", "directional": true, "transitive": false, "evidence_required": true, "cycle_policy": "allow-attributed"},
    {"id": "supersedes", "domain": "record", "range": "record", "directional": true, "transitive": false, "evidence_required": true, "cycle_policy": "forbid"},
    {"id": "authorizes", "domain": "HumanInstruction", "range": "AcceptedScope", "directional": true, "transitive": false, "evidence_required": true, "cycle_policy": "forbid"}
  ],
  "work_item": {
    "initial": "orient",
    "states": ["orient", "source", "propose", "review", "human-decision", "effect", "receipt", "hold", "refused", "cancelled", "returned"],
    "terminal": ["hold", "refused", "cancelled", "returned"],
    "happy_path": ["orient", "source", "propose", "review", "human-decision", "effect", "receipt", "returned"],
    "unknown_transition": "hold"
  },
  "rules": [
    "capability, permission, gate, and effect are distinct types",
    "unknown fields, unknown types, implicit nulls, and undeclared defaults fail closed",
    "literal source and normalized meaning are never the same record",
    "only a human decision may create AcceptedMeaning or AcceptedScope",
    "projection requires source binding, transformation identity, loss, review state, and no-write-back",
    "schema validity proves structure only"
  ],
  "review_status": "review-required",
  "verified": false
}
